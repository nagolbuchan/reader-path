# Backend
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
TEMPERATURE=0.0

NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=generate-a-long-random-string
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
# Browser-facing API base (Vite proxy in local dev). Google OAuth redirect must match:
#   {PUBLIC_API_URL}/auth/callback
# e.g. http://localhost:5173/api/auth/callback
PUBLIC_API_URL=http://localhost:5173/api

GOOGLE_BOOKS_API_KEY=
# Optional comma-separated public Google Sheets CSV export URLs (defaults to TMU undergrad + grad lists)
TMU_SHEET_CSV_URLS=
SERPER_API_KEY=
